{
    "name": "agrona",
    "version": "0.1.4",
    "description": "TypeScript version of agrona DirectBuffer to use with Simple Binary Encoding",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dist": "rm -rf ./dist && tsc",
        "lint": "eslint --ext .js,.ts --fix .",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
        "test": "jest --passWithNoTests"
    },
    "files": [
        "/dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rafalpiotrowski/agrona-ts.git"
    },
    "keywords": [
        "SBE",
        "Simple-Binary-Encoding",
        "Aeron",
        "Agrona",
        "Encoding"
    ],
    "author": "Rafał Piotrowski",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/rafalpiotrowski/agrona-ts/issues"
    },
    "homepage": "https://github.com/rafalpiotrowski/agrona-ts#readme",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@typescript-eslint/parser": "^8.32.1",
        "eslint": "^9.27.0",
        "eslint-config-love": "^120.0.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "globals": "^16.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "ts-jest": "^29.3.4"
    }
}
